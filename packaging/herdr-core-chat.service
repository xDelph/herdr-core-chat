# Service utilisateur de Herdr Core Chat — préparé, non publié ici (P8).
#
# ⚠️ **Utilisateur, pas système.** Le démon lit les sessions de l'utilisateur
# (`~/.pi`, `~/.codex`, `~/.claude`, les bases opencode/devin) et lui parle par
# le socket herdr-core : un service système tournerait avec un autre HOME et ne
# verrait rien.
#
# Installation (documentée, pas automatique) :
#   mkdir -p ~/.config/systemd/user
#   cp herdr-core-chat.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now herdr-core-chat.service
[Unit]
Description=Herdr Core Chat (PWA distante pour Herdr.app / herdr-core)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr-core-chat
Restart=on-failure
RestartSec=3
# Le démon refuse un bind public ; le tailnet est l'unique frontière d'accès.
Environment=HERDR_CORE_CHAT_BIND=127.0.0.1
Environment=HERDR_CORE_CHAT_PORT=8792

[Install]
WantedBy=default.target
